{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2
    },
    "color": {"1": "38;2;122;162;247", "2": "38;2;125;207;255"}
  },
  "display": {
    "separator": " 󰅂 ",
    "color": {
      "keys": "38;2;122;162;247"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "38;2;125;207;255",
        "at": "38;2;255;158;100",
        "host": "38;2;187;154;247"
      }
    },
    "separator",
    {
      "type": "os",
      "key": "󰌽 OS",
      "keyColor": "38;2;122;162;247"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "38;2;125;207;255"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "38;2;255;158;100"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "38;2;187;154;247"
    },
    {
      "type": "terminal",
      "key": "󰞍 Terminal",
      "keyColor": "38;2;122;162;247"
    },
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "38;2;125;207;255"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "memory",
      "key": "󰘚 Memory",
      "keyColor": "38;2;255;158;100"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
