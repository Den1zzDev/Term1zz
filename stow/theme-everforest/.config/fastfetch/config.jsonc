{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2
    },
    "color": {"1": "38;2;167;192;128", "2": "38;2;219;188;127"}
  },
  "display": {
    "separator": " 󰅂 ",
    "color": {
      "keys": "38;2;167;192;128"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "38;2;127;187;179",
        "at": "38;2;230;152;117",
        "host": "38;2;219;188;127"
      }
    },
    "separator",
    {
      "type": "os",
      "key": "󰌽 OS",
      "keyColor": "38;2;167;192;128"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "38;2;127;187;179"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "38;2;219;188;127"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "38;2;230;152;117"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "38;2;214;153;182"
    },
    {
      "type": "terminal",
      "key": "󰞍 Terminal",
      "keyColor": "38;2;167;192;128"
    },
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "38;2;127;187;179"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "38;2;219;188;127"
    },
    {
      "type": "memory",
      "key": "󰘚 Memory",
      "keyColor": "38;2;230;152;117"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
